# Application runtime configuration consumed by config.Load. Supply real values
# through the deployment environment or a secret manager.
AI_SHOPPING_MYSQL_DSN=REPLACE_WITH_RUNTIME_DSN
AI_SHOPPING_REDIS_ADDR=localhost:6379
AI_SHOPPING_KAFKA_BROKERS=localhost:9092
AI_SHOPPING_MINIO_ENDPOINT=localhost:9000
AI_SHOPPING_MILVUS_ADDRESS=localhost:19530

# Docker Compose dependency provisioning variables. They configure local
# dependencies and are not read by the application runtime config.Load.
APP_ENV=development
LOG_LEVEL=info
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=user_db
REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:9092
MILVUS_ADDR=localhost:19530
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
AI_SHOPPING_JWT_SECRET=
LLM_API_KEY=
